+// Agent notifications are sent as XDG desktop notifications
+// (org.freedesktop.Notifications), which the user's notification daemon (e.g.
+// noctalia) displays. The in-app pop-up window is not used.
+#[zbus::proxy(
+    interface = "org.freedesktop.Notifications",
+    default_service = "org.freedesktop.Notifications",
+    default_path = "/org/freedesktop/Notifications"
+)]
+trait DesktopNotifications {
+    fn notify(
+        &self,
+        app_name: &str,
+        replaces_id: u32,
+        app_icon: &str,
+        summary: &str,
+        body: &str,
+        actions: &[&str],
+        hints: &std::collections::HashMap<&str, zbus::zvariant::Value<'_>>,
+        expire_timeout: i32,
+    ) -> zbus::Result<u32>;
+}
+
+async fn send_desktop_notification(summary: &str, body: &str) {
+    let Ok(connection) = zbus::Connection::session().await else {
+        return;
+    };
+    let Ok(proxy) = DesktopNotificationsProxy::new(&connection).await else {
+        return;
+    };
+    let hints = std::collections::HashMap::<&str, zbus::zvariant::Value<'_>>::new();
+    let _ = proxy
+        .notify("Zed", 0, "", summary, body, &[], &hints, 5000)
+        .await;
+}
+
 pub(crate) const DRAFT_PROMPT_PERSIST_DEBOUNCE: Duration = Duration::from_millis(250);
 
