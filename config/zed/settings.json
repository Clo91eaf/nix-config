// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run the `open default settings` command
// from the command palette or from `Zed` application menu.
{
  "code_lens": "on",
  "cli_default_open_behavior": "existing_window",
  "active_pane_modifiers": {
    "inactive_opacity": 0.7
  },
  "diff_view_style": "unified",
  "vim": {
    "default_mode": "normal",
  },
  "diagnostics": {
    "inline": {
      "enabled": true,
    },
  },
  "icon_theme": {
    "mode": "dark",
    "light": "Zed (Default)",
    "dark": "Catppuccin Mocha",
  },
  "tab_size": 2,
  "debugger": {
    "dock": "left",
  },
  "terminal": {
    "cursor_shape": "bar",
    "font_family": "FiraCode Nerd Font",
    "font_fallbacks": ["MiSans", "Noto Sans Mono CJK SC", "Noto Sans CJK SC"],
  },
  "restore_on_startup": "last_workspace",
  "which_key": {
    "delay_ms": 200,
    "enabled": true,
  },
  "autosave": {
    "after_delay": {
      "milliseconds": 1000,
    },
  },
  "agent_servers": {
    "codex-acp": {
      "default_config_options": {
        "mode": "agent-full-access"
      },
      "type": "registry"
    },
    "claude-acp": {
      "type": "registry"
    },
  },
  "ssh_connections": [
    {
      "host": "172.24.5.184",
      "args": [],
      "projects": [
        {
          "paths": [
            "/home/clo91eaf/Project/circt-upstream"
          ]
        },
        {
          "paths": [
            "/home/clo91eaf/Project/scala3-bsp-semantic-ls"
          ]
        },
        {
          "paths": [
            "/home/clo91eaf/Project/zaozi"
          ]
        },
        {
          "paths": [
            "/tmp/ut"
          ]
        }
      ]
    },
    {
      "host": "172.24.6.39",
      "username": "root",
      "args": [],
      "projects": [
        {
          "paths": [
            "/root"
          ]
        },
        {
          "paths": [
            "/root/yjh-workspace/circt-nix"
          ]
        },
        {
          "paths": [
            "/root/yjh-workspace/circt/./"
          ]
        },
        {
          "paths": [
            "/root/yjh-workspace/zaozi/./"
          ]
        }
      ]
    }
  ],
  "project_panel": {
    "dock": "left",
  },
  "outline_panel": {
    "dock": "left",
  },
  "collaboration_panel": {
    "dock": "right",
  },
  "agent": {
    "enable_feedback": false,
    "expand_edit_card": false,
    "expand_terminal_card": false,
    "thinking_display": "always_collapsed",
    "default_model": {
      "provider": "zed.dev",
      "model": "claude-sonnet-5",
      "enable_thinking": true,
      "effort": "high",
    },
    "play_sound_when_agent_done": "never",
    "sidebar_side": "right",
    "dock": "right",
    "favorite_models": [],
    "model_parameters": [],
  },
  "git_panel": {
    "tree_view": true,
    "dock": "left",
  },
  "base_keymap": "VSCode",
  "vim_mode": true,
  "buffer_font_fallbacks": ["MiSans", "Noto Sans CJK SC"],
  "ui_font_fallbacks": ["MiSans", "Noto Sans CJK SC"],
  "ui_font_size": 16,
  "buffer_font_size": 16,
  "theme": {
    "mode": "dark",
    "light": "Tokyo Night Light",
    "dark": "Catppuccin Mocha (Blur)",
  },
  "inlay_hints": {
    "show_value_hints": true,
    "enabled": false,
    "show_type_hints": true,
    "show_parameter_hints": true,
    "show_other_hints": true,
    "show_background": true,
    "edit_debounce_ms": 700,
    "scroll_debounce_ms": 50,
  },
  "languages": {
    "JSON": {
      "enable_language_server": false
    },
    "JSONC": {
      "enable_language_server": false
    }
  }
}
